{
  "realm": "nuzul",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "GUEST", "description": "Books rooms" },
      { "name": "HOTEL_ADMIN", "description": "Manages own hotels (scope checked in DB)" },
      { "name": "PLATFORM_ADMIN", "description": "Platform operations" }
    ]
  },
  "defaultRoles": ["GUEST"],
  "clients": [
    {
      "clientId": "nuzul-web",
      "name": "Nuzul SPA",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4200/*" },
      "protocolMappers": [
        {
          "name": "audience-nuzul-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "nuzul-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "nuzul-api",
      "name": "Nuzul API (resource server)",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "guest@nuzul.local",
      "email": "guest@nuzul.local",
      "emailVerified": true,
      "firstName": "Amina",
      "lastName": "Guest",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "guest", "temporary": false }],
      "realmRoles": ["GUEST"]
    },
    {
      "username": "admin@nuzul.local",
      "email": "admin@nuzul.local",
      "emailVerified": true,
      "firstName": "Youssef",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["GUEST", "HOTEL_ADMIN"]
    }
  ]
}
