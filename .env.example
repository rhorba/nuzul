# Local dev: compose.yaml provides all of these. Prod values needed at Sprint 6.
DB_URL=jdbc:postgresql://localhost:5435/nuzul
DB_USER=nuzul
DB_PASSWORD=change-me
REDIS_URL=redis://localhost:6379
ES_URL=http://localhost:9200
ES_USER=
ES_PASSWORD=
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=nuzul-api
OIDC_ISSUER_URI=http://localhost:8180/realms/nuzul
OIDC_AUDIENCE=nuzul-api
S3_BUCKET=nuzul-photos
S3_REGION=eu-west-3
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=http://localhost:9000/nuzul-photos
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@nuzul.local
APP_HOLD_MINUTES=10
APP_CORS_ORIGIN=http://localhost:4200
APP_TIME_ZONE=Africa/Casablanca
# Hold expiry job (story 2.4): ISO-8601 interval, holds expired per run
APP_EXPIRY_ENABLED=true
APP_EXPIRY_INTERVAL=PT30S
APP_EXPIRY_BATCH_SIZE=500
# Outbox relay (story 3.1): poll interval, rows per run, tries before a row is parked, time budget per run (under 45 s),
# how long published rows are kept and when they are deleted
APP_OUTBOX_ENABLED=true
APP_OUTBOX_INTERVAL=PT1S
APP_OUTBOX_BATCH_SIZE=100
APP_OUTBOX_MAX_ATTEMPTS=10
APP_OUTBOX_RUN_BUDGET=PT30S
APP_OUTBOX_RETENTION=P7D
APP_OUTBOX_RETENTION_CRON=0 30 3 * * *
# Event topics (story 3.1): partitions per topic, replication factor (at most the number of brokers)
APP_KAFKA_PARTITIONS=3
APP_KAFKA_REPLICAS=1
# Rate limits (story 2.5): POST /reservations per guest (requests per ISO-8601 period), unpaid holds per guest
APP_RATE_LIMIT_RESERVATION_POST_CAPACITY=30
APP_RATE_LIMIT_RESERVATION_POST_PERIOD=PT1M
APP_RATE_LIMIT_MAX_ACTIVE_HOLDS=5
# Demo data (story 1.5). Enable on ONE instance only: hotels are matched by name, concurrent seeders duplicate them.
APP_SEED_ENABLED=false
APP_SEED_OWNER_SUB=5f0c3a1e-7b2d-4c8e-9a41-2d6e8b7a1f35
